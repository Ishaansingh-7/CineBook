digraph cinebook {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.1, bgcolor="white", pad=0.3, fontname="Helvetica"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [color="#555555", penwidth=1.3, dir=both, fontname="Helvetica", fontsize=9];

  users [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>USERS</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">user_id</td></tr>
      <tr><td></td><td align="left">name</td></tr>
      <tr><td><b>UQ</b></td><td align="left">email</td></tr>
      <tr><td></td><td align="left">phone</td></tr>
    </table>>];

  movies [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>MOVIES</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">movie_id</td></tr>
      <tr><td></td><td align="left">title</td></tr>
      <tr><td></td><td align="left">genre</td></tr>
      <tr><td></td><td align="left">language</td></tr>
      <tr><td></td><td align="left">duration_min</td></tr>
      <tr><td></td><td align="left">certificate</td></tr>
    </table>>];

  screens [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>SCREENS</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">screen_id</td></tr>
      <tr><td><b>UQ</b></td><td align="left">screen_name</td></tr>
    </table>>];

  seats [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>SEATS</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">seat_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">screen_id</td></tr>
      <tr><td></td><td align="left">row_label</td></tr>
      <tr><td></td><td align="left">seat_no</td></tr>
      <tr><td></td><td align="left">seat_type</td></tr>
    </table>>];

  shows [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>SHOWS</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">show_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">movie_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">screen_id</td></tr>
      <tr><td></td><td align="left">show_time</td></tr>
      <tr><td></td><td align="left">base_price</td></tr>
    </table>>];

  bookings [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>BOOKINGS</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">booking_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">user_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">show_id</td></tr>
      <tr><td></td><td align="left">booked_at</td></tr>
      <tr><td></td><td align="left">total_amount</td></tr>
      <tr><td></td><td align="left">status</td></tr>
    </table>>];

  booking_seats [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>BOOKING_SEATS</b></font></td></tr>
      <tr><td align="left"><b>PK, FK</b></td><td align="left">booking_id</td></tr>
      <tr><td align="left"><b>PK, FK</b></td><td align="left">seat_id</td></tr>
      <tr><td></td><td align="left">price</td></tr>
    </table>>];

  booking_log [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#333333">
      <tr><td bgcolor="#1f3a5f" colspan="2"><font color="white"><b>BOOKING_LOG</b></font></td></tr>
      <tr><td align="left"><b>PK</b></td><td align="left">log_id</td></tr>
      <tr><td align="left"><b>FK</b></td><td align="left">booking_id</td></tr>
      <tr><td></td><td align="left">action</td></tr>
      <tr><td></td><td align="left">amount</td></tr>
      <tr><td></td><td align="left">logged_at</td></tr>
    </table>>];

  movies   -> shows         [arrowtail=tee, arrowhead=crow, label=" screened in "];
  screens  -> shows         [arrowtail=tee, arrowhead=crow, label=" hosts "];
  screens  -> seats         [arrowtail=tee, arrowhead=crow, label=" contains "];
  users    -> bookings      [arrowtail=tee, arrowhead=crow, label=" makes "];
  shows    -> bookings      [arrowtail=tee, arrowhead=crow, label=" has "];
  bookings -> booking_seats [arrowtail=tee, arrowhead=crow, label=" includes "];
  seats    -> booking_seats [arrowtail=tee, arrowhead=crow, label=" reserved as "];
  bookings -> booking_log   [arrowtail=tee, arrowhead=crow, label=" logged in "];
}
